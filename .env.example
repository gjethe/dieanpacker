# Copy to .env.local (local) or set in the hosting dashboard (production). Never commit real values.

# Public base URL used for canonicals, sitemap and structured data (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://dieanpacker.at

# --- Enquiry e-mail (authenticated SMTP) ---
# Recommended: the existing Hostinger mailbox of the domain, so SPF/DKIM align with dieanpacker.at.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
# "true" for port 465 (implicit TLS); "false" for 587 (STARTTLS). Defaults to true when port is 465.
SMTP_SECURE=true
SMTP_USER=office@dieanpacker.at
SMTP_PASS=change-me
# Sender address (must be the authenticated mailbox or an alias of it). Defaults to SMTP_USER.
MAIL_FROM=office@dieanpacker.at
# Recipient of enquiries. Defaults to office@dieanpacker.at.
CONTACT_TO=office@dieanpacker.at

# Max enquiries per IP per 10 minutes (default 5).
# ANFRAGE_RATE_LIMIT=5

# --- Optional analytics (only loaded after consent) ---
# Leave empty unless the client wants Google Analytics. Update the privacy policy before enabling.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# --- Test only, never set in production ---
# MAIL_TRANSPORT=json   # builds e-mails without sending them (used by Playwright)
