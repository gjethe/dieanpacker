# Copy to .env.local (local) or set in the hosting dashboard (production). Never commit real values.
# The site URL is fixed to https://dieanpacker.at in lib/site.ts (canonicals, sitemap, OG, JSON-LD).

# --- Contact form e-mail (Hostinger SMTP via Nodemailer, server-side only) ---
SMTP_HOST=smtp.hostinger.com
# 465 = implicit TLS (SMTP_SECURE=true). Alternative: 587 with SMTP_SECURE=false (STARTTLS).
SMTP_PORT=465
SMTP_SECURE=true
# Full Hostinger mailbox address, e.g. office@dieanpacker.at. Also used as sender.
SMTP_USER=
SMTP_PASSWORD=
# Recipient of enquiries. Defaults to office@dieanpacker.at.
CONTACT_EMAIL=

# Optional: sender address if it differs from SMTP_USER (must be an alias of that mailbox).
# MAIL_FROM=
# Optional: max enquiries per IP per 10 minutes (default 5).
# ANFRAGE_RATE_LIMIT=5

# --- Optional analytics (only loaded after consent) ---
# Leave empty unless the client wants Google Analytics. Update the privacy policy before enabling.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# --- Test only, never set in production ---
# MAIL_TRANSPORT=json   # builds e-mails without sending them (used by Playwright)
